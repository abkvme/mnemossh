cobertura.xml
lcov.info

# --- Generated keys and mnemonic phrases ---
# This tool writes private keys and BIP-39 phrases; anything matching these must
# never reach a commit. A leaked mnemonic is equivalent to a leaked private key.
id_ed25519
id_ed25519.pub
id_rsa
id_rsa.pub
*.pem
*.key
mnemonic.txt
phrase.txt
*.mnemonic

